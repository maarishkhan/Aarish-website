# Core site settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin credentials for protected content management
ADMIN_EMAIL=admin@university.edu
ADMIN_PASSWORD=choose-a-strong-password
# Random string, 16+ chars (e.g. `openssl rand -hex 32`); required in production
ADMIN_SESSION_SECRET=

# Research AI (optional). Without a key it answers using built-in search over the site content.
# Supported providers: none, anthropic, openai, gemini
AI_PROVIDER=none
AI_API_KEY=
# Optional; defaults to a small, fast model for the chosen provider
AI_MODEL=

# Optional analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Email updates (optional, free): send through your Gmail account.
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an app password at https://myaccount.google.com/apppasswords
# The sign-up form in the footer only appears when both are set and SUPABASE_SERVICE_ROLE_KEY is set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name in the From line, e.g. Aarish Khan
EMAIL_FROM_NAME=
